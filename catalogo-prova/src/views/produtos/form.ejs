<h1>Novo Produto</h1>

<% if (erro) { %>
  <p style="color: red;"><%= erro %></p>
<% } %>

<form action="/produtos" method="POST">
  <div>
    <label for="nome">Nome:</label>
    <input type="text" id="nome" name="nome" value="<%= dados && dados.nome ? dados.nome : '' %>">
  </div>

  <div>
    <label for="preco">Preço:</label>
    <input type="number" step="0.01" id="preco" name="preco" value="<%= dados && dados.preco ? dados.preco : '' %>">
  </div>

  <div>
    <label for="categoriaId">Categoria:</label>
    <select id="categoriaId" name="categoriaId">
      <option value="">Selecione uma categoria</option>
      <% if (categorias && categorias.length > 0) { %>
        <% categorias.forEach(categoria => { %>
          <option value="<%= categoria.id %>" <%= dados && String(dados.categoriaId) === String(categoria.id) ? 'selected' : '' %>>
            <%= categoria.nome %>
          </option>
        <% }) %>
      <% } %>
    </select>
  </div>

  <button type="submit">Salvar</button>
</form>

<a href="/produtos">Voltar</a>