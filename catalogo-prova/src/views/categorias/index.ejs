<h1>Categorias</h1>

<a href="/categorias/nova">Nova Categoria</a>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
    </tr>
  </thead>
  <tbody>
    <% if (categorias && categorias.length > 0) { %>
      <% categorias.forEach(categoria => { %>
        <tr>
          <td><%= categoria.id %></td>
          <td><%= categoria.nome %></td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="2">Nenhuma categoria cadastrada.</td>
      </tr>
    <% } %>
  </tbody>
</table>